NODE_ENV=development
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true
GEMINI_MODEL=gemini-3.7-flash
DATABASE_URL=postgresql://webpilot:webpilot@localhost:5432/webpilot
DIRECT_URL=postgresql://webpilot:webpilot@localhost:5432/webpilot
ARTIFACT_BUCKET=webpilot-dev-artifacts
TASK_QUEUE=webpilot-runs
TASK_LOCATION=us-central1
WORKER_URL=http://localhost:4100
API_URL=http://localhost:4000
NEXT_PUBLIC_API_BASE=/backend
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
FIREBASE_PROJECT_ID=
LOCAL_AUTH_BYPASS=true
LOCAL_USER_EMAIL=demo@webpilot.local
INTERNAL_WORKER_TOKEN=dev-worker-token
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=
SLACK_REDIRECT_URI=http://localhost:4000/api/v1/integrations/slack/callback
GMAIL_SENDER=
GOOGLE_CHAT_WEBHOOK=

LOCAL_TASKS=true
LOCAL_PUBSUB=true
LOCAL_SCHEDULER=true
LOCAL_ARTIFACTS=true
LOCAL_SECRETS=true
ALLOW_PRIVATE_DEMO=true
MOCK_AI=false
NEXT_PUBLIC_LOCAL_AUTH_BYPASS=true
API_PUBLIC_URL=http://localhost:4000
SCHEDULER_AUDIENCE=http://localhost:4000
TASK_INVOKER_SA=
SCHEDULER_INVOKER_SA=
GMAIL_OAUTH_SECRET_REF=
SLACK_STATE_SECRET=
WORKER_AUDIENCE=http://localhost:4100
PUBSUB_TOPIC=webpilot-events
